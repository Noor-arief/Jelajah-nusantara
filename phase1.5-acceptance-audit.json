    "style": ".vireqo-ai-shell { position: fixed; right: 22px; bottom: 22px; z-index: 2147483000; font-family: Arial, sans-serif; }\n.vireqo-ai-launcher { display: inline-flex; align-items: center; gap: 9px; border: 0; border-radius: 999px; padding: 13px 18px; color: #fff; font-size: 14px; font-weight: 700; cursor: pointer; box-shadow: 0 10px 28px rgba(0,0,0,.18); }\n.vireqo-ai-avatar { position:relative; width:30px; height:30px; flex:0 0 30px; border-radius:50%; background:#fff; display:grid; place-items:center; overflow:visible; animation:vireqoNusaFloat 2.2s ease-in-out infinite; }\n.vireqo-ai-face { color:#0f4c4c; font-size:13px; font-weight:800; line-height:1; margin-top:5px; }\n.vireqo-ai-blangkon { position:absolute; left:3px; right:3px; top:2px; height:10px; background:#8a5a2b; border-radius:10px 10px 4px 4px; transform:rotate(-2deg); box-shadow:inset 0 -2px 0 rgba(0,0,0,.18); }\n.vireqo-ai-blangkon::after { content:''; position:absolute; width:8px; height:8px; right:-3px; top:1px; background:#8a5a2b; border-radius:50%; }\n@keyframes vireqoNusaFloat { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-3px)} }\n.vireqo-ai-widget { width:min(390px, calc(100vw - 28px)); max-height:min(680px, calc(100vh - 44px)); display:flex; flex-direction:column; border:1px solid #e5e7eb; border-radius:18px; overflow:hidden; background:#fff; box-shadow:0 18px 48px rgba(0,0,0,.18); }\n.vireqo-ai-widget[hidden], .vireqo-ai-launcher[hidden] { display: none !important; }\n.vireqo-ai-header { display:flex; align-items:center; justify-content:space-between; gap:12px; padding: 16px; color: #fff; }\n.vireqo-ai-header-copy { min-width:0; }\n.vireqo-ai-title { font-weight: 700; }\n.vireqo-ai-subtitle { font-size: 12px; opacity: .85; margin-top: 2px; }\n.vireqo-ai-close { flex:0 0 auto; width:32px; height:32px; border:0; border-radius:50%; background:rgba(255,255,255,.14); color:#fff; font-size:23px; line-height:1; cursor:pointer; }\n.vireqo-ai-messages { min-height:180px; flex:1 1 auto; overflow:auto; padding:16px; background:#f9fafb; }\n.vireqo-ai-message { padding: 10px 12px; border-radius: 12px; margin: 8px 0; max-width: 84%; line-height: 1.4; font-size: 14px; word-wrap: break-word; }\n.vireqo-ai-message.assistant { background: #fff; border: 1px solid #e5e7eb; }\n.vireqo-ai-message.user { background: #111827; color: #fff; margin-left: auto; }\n.vireqo-ai-quick-actions { display:flex; flex-wrap:wrap; gap:7px; padding:0 12px 12px; background:#f9fafb; }\n.vireqo-ai-quick-actions[hidden] { display:none; }\n.vireqo-ai-quick-action { border:1px solid #d1d5db; background:#fff; color:#374151; border-radius:999px; padding:7px 10px; font-size:12px; cursor:pointer; }\n.vireqo-ai-quick-action:hover { background:#f3f4f6; }\n.vireqo-ai-inputbar { display: flex; gap: 8px; padding: 12px; border-top: 1px solid #e5e7eb; }\n.vireqo-ai-inputbar input { flex: 1; min-width: 0; border: 1px solid #d1d5db; border-radius: 10px; padding: 10px; }\n.vireqo-ai-inputbar button { border: 0; color: #fff; border-radius: 10px; padding: 10px 14px; cursor: pointer; }\n.vireqo-ai-inputbar button:disabled { opacity: .6; cursor: wait; }\n.vireqo-ai-handover { padding: 0 12px 12px; background: #fff; }\n.vireqo-ai-handover a { display: block; text-align: center; color: #fff; text-decoration: none; border-radius: 10px; padding: 10px 12px; font-size: 14px; font-weight: 700; }\n.vireqo-ai-powered { display: flex; align-items: center; justify-content: center; gap: 6px; min-height: 34px; padding: 7px 12px; border-top: 1px solid #eef0f3; background: #fff; color: #6b7280; font-size: 10px; line-height: 1; }\n.vireqo-ai-powered a { display: inline-flex; align-items: center; text-decoration: none; }\n.vireqo-ai-powered img { display: block; width: auto; height: 18px; max-width: 82px; object-fit: contain; }\n@media (max-width: 480px) {\n  .vireqo-ai-shell { right:14px; bottom:14px; }\n  .vireqo-ai-widget { width:calc(100vw - 28px); max-height:calc(100dvh - 28px); border-radius:16px; }\n  .vireqo-ai-messages { min-height:160px; max-height:none; }\n}\n\n.vireqo-ai-powered[hidden] { display:none !important; }\n.vireqo-ai-header { flex:0 0 auto; }\n.vireqo-ai-quick-actions, .vireqo-ai-inputbar, .vireqo-ai-powered { flex:0 0 auto; }\n@media (max-height: 720px) and (min-width: 481px) {\n  .vireqo-ai-shell { bottom:12px; }\n  .vireqo-ai-widget { max-height:calc(100vh - 24px); }\n  .vireqo-ai-messages { min-height:140px; }\n}\n\n.vireqo-ai-header-profile{display:flex;align-items:center;gap:12px;min-width:0}\n.vireqo-ai-header-avatar{width:46px;height:46px;flex:0 0 46px;border-radius:50%;overflow:hidden;background:#fff;border:2px solid rgba(255,255,255,.85);box-shadow:0 2px 8px rgba(0,0,0,.15)}\n.vireqo-ai-header-avatar img{width:100%;height:100%;display:block;object-fit:cover}\n.vireqo-ai-header-copy{display:flex;flex-direction:column;justify-content:center;min-width:0}\n.vireqo-ai-subtitle{display:flex;align-items:center;gap:7px}\n.vireqo-ai-online-dot{width:8px;height:8px;border-radius:50%;background:#4ade80;box-shadow:0 0 0 3px rgba(74,222,128,.16)}\n",
