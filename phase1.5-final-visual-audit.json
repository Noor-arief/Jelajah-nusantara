  "nusa": {
    "html": "<style>.vireqo-ai-shell { position: fixed; right: 22px; bottom: 22px; z-index: 2147483000; font-family: Arial, sans-serif; }\n.vireqo-ai-launcher { display: inline-flex; align-items: center; gap: 9px; border: 0; border-radius: 999px; padding: 13px 18px; color: #fff; font-size: 14px; font-weight: 700; cursor: pointer; box-shadow: 0 10px 28px rgba(0,0,0,.18); }\n.vireqo-ai-avatar { position:relative; width:30px; height:30px; flex:0 0 30px; border-radius:50%; background:#fff; display:grid; place-items:center; overflow:visible; animation:vireqoNusaFloat 2.2s ease-in-out infinite; }\n.vireqo-ai-face { color:#0f4c4c; font-size:13px; font-weight:800; line-height:1; margin-top:5px; }\n.vireqo-ai-blangkon { position:absolute; left:3px; right:3px; top:2px; height:10px; background:#8a5a2b; border-radius:10px 10px 4px 4px; transform:rotate(-2deg); box-shadow:inset 0 -2px 0 rgba(0,0,0,.18); }\n.vireqo-ai-blangkon::after { content:''; position:absolute; width:8px; height:8px; right:-3px; top:1px; background:#8a5a2b; border-radius:50%; }\n@keyframes vireqoNusaFloat { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-3px)} }\n.vireqo-ai-widget { width:min(390px, calc(100vw - 28px)); max-height:min(680px, calc(100vh - 44px)); display:flex; flex-direction:column; border:1px solid #e5e7eb; border-radius:18px; overflow:hidden; background:#fff; box-shadow:0 18px 48px rgba(0,0,0,.18); }\n.vireqo-ai-widget[hidden], .vireqo-ai-launcher[hidden] { display: none !important; }\n.vireqo-ai-header { display:flex; align-items:center; justify-content:space-between; gap:12px; padding: 16px; color: #fff; }\n.vireqo-ai-header-copy { min-width:0; }\n.vireqo-ai-title { font-weight: 700; }\n.vireqo-ai-subtitle { font-size: 12px; opacity: .85; margin-top: 2px; }\n.vireqo-ai-close { flex:0 0 auto; width:32px; height:32px; border:0; border-radius:50%; background:rgba(255,255,255,.14); color:#fff; font-size:23px; line-height:1; cursor:pointer; }\n.vireqo-ai-messages { min-height:180px; flex:1 1 auto; overflow:auto; padding:16px; background:#f9fafb; }\n.vireqo-ai-message { padding: 10px 12px; border-radius: 12px; margin: 8px 0; max-width: 84%; line-height: 1.4; font-size: 14px; word-wrap: break-word; }\n.vireqo-ai-message.assistant { background: #fff; border: 1px solid #e5e7eb; }\n.vireqo-ai-message.user { background: #111827; color: #fff; margin-left: auto; }\n.vireqo-ai-quick-actions { display:flex; flex-wrap:wrap; gap:7px; padding:0 12px 12px; background:#f9fafb; }\n.vireqo-ai-quick-actions[hidden] { display:none; }\n.vireqo-ai-quick-action { border:1px solid #d1d5db; background:#fff; color:#374151; border-radius:999px; padding:7px 10px; font-size:12px; cursor:pointer; }\n.vireqo-ai-quick-action:hover { background:#f3f4f6; }\n.vireqo-ai-inputbar { display: flex; gap: 8px; padding: 12px; border-top: 1px solid #e5e7eb; }\n.vireqo-ai-inputbar input { flex: 1; min-width: 0; border: 1px solid #d1d5db; border-radius: 10px; padding: 10px; }\n.vireqo-ai-inputbar button { border: 0; color: #fff; border-radius: 10px; padding: 10px 14px; cursor: pointer; }\n.vireqo-ai-inputbar button:disabled { opacity: .6; cursor: wait; }\n.vireqo-ai-handover { padding: 0 12px 12px; background: #fff; }\n.vireqo-ai-handover a { display: block; text-align: center; color: #fff; text-decoration: none; border-radius: 10px; padding: 10px 12px; font-size: 14px; font-weight: 700; }\n.vireqo-ai-powered { display: flex; align-items: center; justify-content: center; gap: 6px; min-height: 34px; padding: 7px 12px; border-top: 1px solid #eef0f3; background: #fff; color: #6b7280; font-size: 10px; line-height: 1; }\n.vireqo-ai-powered a { display: inline-flex; align-items: center; text-decoration: none; }\n.vireqo-ai-powered img { display: block; width: auto; height: 18px; max-width: 82px; object-fit: contain; }\n@media (max-width: 480px) {\n  .vireqo-ai-shell { right:14px; bottom:14px; }\n  .vireqo-ai-widget { width:calc(100vw - 28px); max-height:calc(100dvh - 28px); border-radius:16px; }\n  .vireqo-ai-messages { min-height:160px; max-height:none; }\n}\n\n.vireqo-ai-powered[hidden] { display:none !important; }\n.vireqo-ai-header { flex:0 0 auto; }\n.vireqo-ai-quick-actions, .vireqo-ai-inputbar, .vireqo-ai-powered { flex:0 0 auto; }\n@media (max-height: 720px) and (min-width: 481px) {\n  .vireqo-ai-shell { bottom:12px; }\n  .vireqo-ai-widget { max-height:calc(100vh - 24px); }\n  .vireqo-ai-messages { min-height:140px; }\n}\n\n.vireqo-ai-header-profile{display:flex;align-items:center;gap:12px;min-width:0}\n.vireqo-ai-header-avatar{width:46px;height:46px;flex:0 0 46px;border-radius:50%;overflow:hidden;background:#fff;border:2px solid rgba(255,255,255,.85);box-shadow:0 2px 8px rgba(0,0,0,.15)}\n.vireqo-ai-header-avatar img{width:100%;height:100%;display:block;object-fit:cover}\n.vireqo-ai-header-copy{display:flex;flex-direction:column;justify-content:center;min-width:0}\n.vireqo-ai-subtitle{display:flex;align-items:center;gap:7px}\n.vireqo-ai-online-dot{width:8px;height:8px;border-radius:50%;background:#4ade80;box-shadow:0 0 0 3px rgba(74,222,128,.16)}\n</style><div class=\"vireqo-ai-shell\">\n      <button class=\"vireqo-ai-launcher\" type=\"button\" style=\"background:#0f4c4c\" aria-label=\"Ask NUSA\" aria-expanded=\"false\">\n        <span class=\"vireqo-ai-avatar\" aria-hidden=\"true\"><img src=\"https://assistant.vireqo.id/assets/nusa-avatar.svg\" alt=\"\"></span>\n        <span>Ask NUSA</span>\n      </button>\n      <section class=\"vireqo-ai-widget\" hidden=\"\" aria-label=\"NUSA chat\">\n      <div class=\"vireqo-ai-header\" style=\"background:#0f4c4c\">\n        <div class=\"vireqo-ai-header-profile\">\n          <span class=\"vireqo-ai-header-avatar\" aria-hidden=\"true\"><img src=\"https://assistant.vireqo.id/assets/nusa-avatar.svg\" alt=\"\"></span>\n          <div class=\"vireqo-ai-header-copy\">\n            <div class=\"vireqo-ai-title\">NUSA</div>\n            <div class=\"vireqo-ai-subtitle\"><span class=\"vireqo-ai-online-dot\" aria-hidden=\"true\"></span><span>Online</span></div>\n          </div>\n        </div>\n        <button class=\"vireqo-ai-close\" type=\"button\" aria-label=\"Tutup chat\">×</button>\n      </div>\n      <div class=\"vireqo-ai-messages\" aria-live=\"polite\"><div class=\"vireqo-ai-message assistant jl-nusa-message-enter\">Halo, saya NUSA, AI Travel Assistant JelNusa. Ada yang bisa saya bantu?</div></div>\n      <div class=\"vireqo-ai-quick-actions\" aria-label=\"Pilihan cepat\"><button type=\"button\" class=\"vireqo-ai-quick-action\">Rekomendasi destinasi</button><button type=\"button\" class=\"vireqo-ai-quick-action\">Buat itinerary</button><button type=\"button\" class=\"vireqo-ai-quick-action\">Estimasi budget</button><button type=\"button\" class=\"vireqo-ai-quick-action\">Packing &amp; safety</button></div>\n      <form class=\"vireqo-ai-inputbar\">\n        <input type=\"text\" autocomplete=\"off\" aria-label=\"Message\" placeholder=\"Tanyakan perjalanan Indonesia...\">\n        <button type=\"submit\" style=\"background:#0f4c4c\">Kirim</button>\n      </form>\n      <div class=\"vireqo-ai-powered\" hidden=\"\"><span>Powered by</span><a href=\"https://vireqo.id/\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Powered by Vireqo\"><img src=\"https://vireqo.id/logo.png\" alt=\"Vireqo\" loading=\"lazy\"></a></div></section>\n    </div><style id=\"jl-nusa-motion-v1\">\n      @keyframes jlNusaLauncherIn{\n        from{opacity:0;transform:translateY(8px) scale(.97)}\n        to{opacity:1;transform:none}\n      }\n      @keyframes jlNusaWidgetIn{\n        from{opacity:0;transform:translateY(12px) scale(.985)}\n        to{opacity:1;transform:none}\n      }\n      @keyframes jlNusaMessageIn{\n        from{opacity:0;transform:translateY(7px)}\n        to{opacity:1;transform:none}\n      }\n      @keyframes jlNusaDotThink{\n        0%,100%{transform:scale(1);opacity:.65}\n        50%{transform:scale(1.45);opacity:1}\n      }\n      @keyframes jlNusaReady{\n        0%{box-shadow:0 0 0 0 rgba(74,222,128,.3)}\n        100%{box-shadow:0 0 0 7px rgba(74,222,128,0)}\n      }\n\n      .vireqo-ai-launcher:not([hidden]){\n        min-height:62px;\n        padding:14px 22px!important;\n        gap:11px!important;\n        font-size:15px!important;\n        letter-spacing:.01em;\n        border:1px solid rgba(255,255,255,.22)!important;\n        box-shadow:0 14px 34px rgba(15,76,76,.34),0 4px 12px rgba(0,0,0,.16)!important;\n        animation:jlNusaLauncherIn 260ms cubic-bezier(.22,1,.36,1) both;\n        transition:transform 180ms cubic-bezier(.22,1,.36,1),box-shadow 220ms ease,filter 220ms ease;\n      }\n      .vireqo-ai-launcher:hover{\n        transform:translateY(-3px) scale(1.015);\n        box-shadow:0 18px 40px rgba(15,76,76,.38),0 6px 16px rgba(0,0,0,.18)!important;\n        filter:saturate(1.06);\n      }\n      .vireqo-ai-launcher:active{transform:scale(.97)}\n\n      .vireqo-ai-avatar{\n        width:34px!important;\n        height:34px!important;\n        flex-basis:34px!important;\n        animation:vireqoNusaFloat 3.8s ease-in-out infinite!important;\n      }\n\n      .vireqo-ai-widget:not([hidden]){\n        animation:jlNusaWidgetIn 300ms cubic-bezier(.22,1,.36,1) both;\n        transform-origin:bottom right;\n      }\n\n      .vireqo-ai-message.jl-nusa-message-enter{\n        animation:jlNusaMessageIn 280ms cubic-bezier(.22,1,.36,1) both;\n      }\n\n      .vireqo-ai-quick-actions:not([hidden]) .vireqo-ai-quick-action{\n        animation:jlNusaMessageIn 260ms cubic-bezier(.22,1,.36,1) both;\n      }\n      .vireqo-ai-quick-action{\n        transition:transform 150ms cubic-bezier(.22,1,.36,1),background-color 180ms ease,border-color 180ms ease!important;\n      }\n      .vireqo-ai-quick-action:active{transform:scale(.96)}\n\n      .vireqo-ai-widget.jl-nusa-thinking .vireqo-ai-online-dot{\n        animation:jlNusaDotThink 900ms ease-in-out infinite;\n      }\n      .vireqo-ai-widget.jl-nusa-ready .vireqo-ai-online-dot{\n        animation:jlNusaReady 650ms ease-out 1;\n      }\n      .vireqo-ai-widget.jl-nusa-thinking .vireqo-ai-inputbar button:disabled{\n        opacity:.72;\n      }\n\n      @media (max-width:768px){\n        .vireqo-ai-shell{\n          right:12px!important;\n          bottom:12px!important;\n        }\n        .vireqo-ai-launcher{\n          min-height:58px!important;\n          padding:12px 18px!important;\n          max-width:calc(100vw - 24px);\n        }\n        .vireqo-ai-widget{\n          width:calc(100vw - 20px)!important;\n          max-height:calc(100dvh - 20px)!important;\n          border-radius:18px!important;\n        }\n        .vireqo-ai-inputbar input{font-size:16px!important}\n      }\n\n      @media (prefers-reduced-motion:reduce){\n        .vireqo-ai-launcher,\n        .vireqo-ai-avatar,\n        .vireqo-ai-widget,\n        .vireqo-ai-message,\n        .vireqo-ai-quick-action,\n        .vireqo-ai-online-dot{\n          animation:none!important;\n          transition:none!important;\n          transform:none!important;\n        }\n      }\n    </style>",
